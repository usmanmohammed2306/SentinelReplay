# Copy to a private .env outside Git before using docker compose.
# Use URL-safe characters in the database password for this preview.
SENTINEL_DB_PASSWORD=replace-with-a-unique-url-safe-password
SENTINEL_APP_DB_PASSWORD=replace-with-a-different-unique-url-safe-password
SENTINEL_API_TOKEN=replace-with-a-random-token-at-least-32-characters
SENTINEL_TRUSTED_PUBLIC_KEY_HOST=/absolute/path/to/signing.ed25519.pub
